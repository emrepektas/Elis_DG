{
  "name": "birthday-journey",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "pack:private": "node scripts/pack-private.mjs",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "node e2e/browser-check.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/audit.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "audit": "node scripts/audit.mjs dist"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
